# 配置文件模板
# 使用方法：把本文件复制一份，改名为 config.py，填入你自己的密钥
# config.py 已被 .gitignore 排除，不会提交到仓库

# 智谱 AI（GLM）
LLM_API_KEY = "在这里填入你的智谱 API Key"
LLM_BASE_URL = "https://open.bigmodel.cn/api/paas/v4/"
LLM_MODEL = "glm-4-flash"

# 知识库目录（可选）：默认 ./kb（项目内示例）；改成你自己的笔记仓库即可
# KB_DIR = r"D:/你的知识库"

# 思考过程开关："auto"（复杂问题才思考）| "on"（总是）| "off"（永不，输出最干净）
SHOW_THINKING = "off"  # 默认关闭：输出最干净；想开启改 on/auto
